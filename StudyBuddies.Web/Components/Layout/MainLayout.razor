@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using StudyBuddies.Web.Dev
@inject Microsoft.Extensions.Localization.IStringLocalizer<StudyBuddies.Web.SharedResource> L
@inject IOptions<DevOptions> DevOpts
@inject IJSRuntime JS

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="sb-appbar">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" />
                <MudText Typo="Typo.h6">@L["App.Title"]</MudText>
            </MudStack>
        </MudLink>
        <MudSpacer />
        <LanguageSwitcher />
        <DarkModeSwitcher IsDark="_isDarkMode" IsDarkChanged="OnThemeChanged" />
        @if (DevOpts.Value.Enabled)
        {
            <DevUserSwitcher />
        }
        <AuthorizeView>
            <Authorized>
                <IncomingRequestBadge />
                <UserMenu />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Login" Variant="Variant.Text" Color="Color.Inherit" Class="sb-btn">@L["Auth.Login"]</MudButton>
                <MudButton Href="Account/Register" Variant="Variant.Outlined" Color="Color.Primary" Class="sb-btn ml-2">@L["Auth.Register"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDarkMode;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext?.Request.Cookies.TryGetValue("theme", out var saved) == true)
        {
            _isDarkMode = saved == "dark";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var saved = await JS.InvokeAsync<string?>("studyBuddiesTheme.get");
            var dark = saved == "dark";
            if (dark != _isDarkMode)
            {
                _isDarkMode = dark;
                StateHasChanged();
            }
        }
        catch (InvalidOperationException)
        {
            // JS interop not available during static SSR; OnInitialized handled the cookie read.
        }
    }

    private Task OnThemeChanged(bool isDark)
    {
        _isDarkMode = isDark;
        return Task.CompletedTask;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#F08A7E",
            Secondary = "#B6A4E8",
            Tertiary = "#7FD1B0",
            Success = "#6FC9A1",
            Warning = "#F5C26B",
            Info = "#7BB6E8",
            AppbarBackground = "#FFF6F0",
            AppbarText = "#3A2E3F",
            Background = "#FFF6F0",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#3A2E3F",
            TextSecondary = "#7A6B7D",
            LinesDefault = "#EFE3E8"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#F4A496",
            Secondary = "#C8B8F0",
            Tertiary = "#8FDDBF",
            Success = "#82D6B0",
            Warning = "#F8CF82",
            Info = "#95C6F0",
            AppbarBackground = "#26212E",
            AppbarText = "#F2E9EF",
            Background = "#1F1822",
            Surface = "#26212E",
            DrawerBackground = "#26212E",
            LinesDefault = "#3A2F40",
            TextPrimary = "#F2E9EF",
            TextSecondary = "#B8A9BD",
            DrawerText = "#F2E9EF",
            ActionDefault = "#B8A9BD"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Nunito", "system-ui", "-apple-system", "Segoe UI", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "14px"
        }
    };
}
