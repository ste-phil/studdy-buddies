@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using StudyBuddies.Web.Dev
@inject Microsoft.Extensions.Localization.IStringLocalizer<StudyBuddies.Web.SharedResource> L
@inject IOptions<DevOptions> DevOpts

<MudThemeProvider Theme="@_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" />
                <MudText Typo="Typo.h6">@L["App.Title"]</MudText>
            </MudStack>
        </MudLink>
        <MudSpacer />
        <LanguageSwitcher />
        @if (DevOpts.Value.Enabled)
        {
            <DevUserSwitcher />
        }
        <AuthorizeView>
            <Authorized>
                <IncomingRequestBadge />
                <UserMenu DisplayName="@(context.User.Identity?.Name ?? string.Empty)" />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Login" Variant="Variant.Text" Color="Color.Inherit">@L["Auth.Login"]</MudButton>
                <MudButton Href="Account/Register" Variant="Variant.Outlined" Color="Color.Inherit" Class="ml-2">@L["Auth.Register"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6366F1",
            Secondary = "#EC4899",
            Tertiary = "#8B5CF6",
            Success = "#10B981",
            Warning = "#F59E0B",
            Info = "#3B82F6",
            AppbarBackground = "#6366F1",
            AppbarText = "#FFFFFF",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            LinesDefault = "#E5E7EB"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Inter", "Helvetica Neue", "Helvetica", "Arial", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        }
    };
}
