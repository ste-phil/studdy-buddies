@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using StudyBuddies.Web.Dev
@inject Microsoft.Extensions.Localization.IStringLocalizer<StudyBuddies.Web.SharedResource> L
@inject IOptions<DevOptions> DevOpts
@inject IJSRuntime JS

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" />
                <MudText Typo="Typo.h6">@L["App.Title"]</MudText>
            </MudStack>
        </MudLink>
        <MudSpacer />
        <LanguageSwitcher />
        <DarkModeSwitcher IsDark="_isDarkMode" IsDarkChanged="OnThemeChanged" />
        @if (DevOpts.Value.Enabled)
        {
            <DevUserSwitcher />
        }
        <AuthorizeView>
            <Authorized>
                <IncomingRequestBadge />
                <UserMenu />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Login" Variant="Variant.Text" Color="Color.Inherit">@L["Auth.Login"]</MudButton>
                <MudButton Href="Account/Register" Variant="Variant.Outlined" Color="Color.Inherit" Class="ml-2">@L["Auth.Register"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDarkMode;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext?.Request.Cookies.TryGetValue("theme", out var saved) == true)
        {
            _isDarkMode = saved == "dark";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var saved = await JS.InvokeAsync<string?>("studyBuddiesTheme.get");
            var dark = saved == "dark";
            if (dark != _isDarkMode)
            {
                _isDarkMode = dark;
                StateHasChanged();
            }
        }
        catch (InvalidOperationException)
        {
            // JS interop not available during static SSR; OnInitialized handled the cookie read.
        }
    }

    private Task OnThemeChanged(bool isDark)
    {
        _isDarkMode = isDark;
        return Task.CompletedTask;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6366F1",
            Secondary = "#EC4899",
            Tertiary = "#8B5CF6",
            Success = "#10B981",
            Warning = "#F59E0B",
            Info = "#3B82F6",
            AppbarBackground = "#6366F1",
            AppbarText = "#FFFFFF",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            LinesDefault = "#E5E7EB"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818CF8",
            Secondary = "#F472B6",
            Tertiary = "#A78BFA",
            Success = "#34D399",
            Warning = "#FBBF24",
            Info = "#60A5FA",
            AppbarBackground = "#1E1B4B",
            AppbarText = "#FFFFFF",
            Background = "#0F172A",
            Surface = "#1E293B",
            DrawerBackground = "#1E293B",
            LinesDefault = "#374151",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#CBD5E1",
            DrawerText = "#F1F5F9",
            ActionDefault = "#CBD5E1"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Inter", "Helvetica Neue", "Helvetica", "Arial", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        }
    };
}
