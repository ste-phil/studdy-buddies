@implements IDisposable
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        @L["Nav.Home"]
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.Dashboard">
                @L["Nav.Dashboard"]
            </MudNavLink>
            <MudNavLink Href="partners" Icon="@Icons.Material.Filled.Group">
                @L["Nav.Partners"]
            </MudNavLink>
            <MudNavLink Href="partners/search" Icon="@Icons.Material.Filled.PersonSearch">
                @L["Nav.SearchPartners"]
            </MudNavLink>
            <MudNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.AccountCircle">
                @L["Nav.Profile"]
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">
                @L["Auth.Login"]
            </MudNavLink>
            <MudNavLink Href="Account/Register" Icon="@Icons.Material.Filled.PersonAdd">
                @L["Auth.Register"]
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
