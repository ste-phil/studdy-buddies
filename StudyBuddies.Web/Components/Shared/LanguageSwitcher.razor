@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<StudyBuddies.Web.SharedResource> L

<MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense="true">
    <ActivatorContent>
        <button type="button"
                class="lang-switcher-trigger"
                aria-label="@L["Lang.SwitchTooltip"]"
                title="@L["Lang.SwitchTooltip"]"
                @onclick="@context.ToggleAsync">
            <span class="lang-flag-circle lang-flag-circle-lg fi fis fi-@(_current)"></span>
        </button>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem OnClick="@(() => SetCulture("de"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <span class="lang-flag-circle fi fis fi-de"></span>
                <MudText>@L["Lang.German"]</MudText>
                @if (_current == "de")
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                }
            </MudStack>
        </MudMenuItem>
        <MudMenuItem OnClick="@(() => SetCulture("es"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <span class="lang-flag-circle fi fis fi-es"></span>
                <MudText>@L["Lang.Spanish"]</MudText>
                @if (_current == "es")
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                }
            </MudStack>
        </MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    private string _current = "es";

    protected override void OnInitialized()
    {
        _current = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    }

    private async Task SetCulture(string culture)
    {
        await JS.InvokeVoidAsync("studyBuddiesLang.set", culture);
    }
}
