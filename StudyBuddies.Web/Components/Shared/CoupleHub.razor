@inject IStringLocalizer<SharedResource> L

<div class="couple-hub">
    <span class="couple-deco couple-deco-1" aria-hidden="true">✨</span>
    <span class="couple-deco couple-deco-2" aria-hidden="true">💕</span>
    <span class="couple-deco couple-deco-3" aria-hidden="true">🌸</span>
    <span class="couple-deco couple-deco-4" aria-hidden="true">✨</span>

    <div class="couple-hub-row">
        <div class="couple-avatar" title="@MyDisplayName">
            @InitialOf(MyDisplayName)
            <span class="couple-flag fi fi-@MyLanguage.ToLower()"></span>
        </div>
        <div class="couple-heart" aria-hidden="true">❤️</div>
        <div class="couple-avatar" title="@Partnership.Partner.DisplayName">
            @InitialOf(Partnership.Partner.DisplayName)
            <span class="couple-flag fi fi-@Partnership.Partner.NativeLanguage.ToLower()"></span>
        </div>
    </div>
    <div class="couple-meta">
        @if (DaysTogether <= 0)
        {
            @L["CoupleHub.JustStarted"]
        }
        else
        {
            <span class="couple-days">@DaysTogether</span> @L["CoupleHub.DaysTogether"]
        }
    </div>
    @if (OnSwitch.HasDelegate)
    {
        <button type="button" class="couple-switch" @onclick="OnSwitch" title="@L["CoupleHub.Switch"]">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" />
            <span>@L["CoupleHub.Switch"]</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public PartnershipSummary Partnership { get; set; } = null!;
    [Parameter, EditorRequired] public string MyDisplayName { get; set; } = "";
    [Parameter, EditorRequired] public string MyLanguage { get; set; } = "";
    [Parameter] public EventCallback OnSwitch { get; set; }

    private int DaysTogether
    {
        get
        {
            var anchor = Partnership.AcceptedAt ?? Partnership.CreatedAt;
            return (int)Math.Floor((DateTime.UtcNow - anchor).TotalDays);
        }
    }

    private static string InitialOf(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpperInvariant(name.Trim()[0]).ToString();
}
