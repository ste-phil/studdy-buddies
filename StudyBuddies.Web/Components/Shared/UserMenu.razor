@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Identity.UserManager<StudyBuddies.Core.Data.ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<MudMenu Label="@_displayName"
         StartIcon="@Icons.Material.Filled.AccountCircle"
         EndIcon="@Icons.Material.Filled.ArrowDropDown"
         Variant="Variant.Text"
         Color="Color.Inherit"
         Style="text-transform:none;"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense="true">
    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">
        @L["Auth.Logout"]
    </MudMenuItem>
</MudMenu>

<form id="user-menu-logout-form" action="Account/Logout" method="post" style="display:none">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="" />
</form>

@code {
    private string _displayName = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(state.User);
            _displayName = !string.IsNullOrWhiteSpace(user?.DisplayName)
                ? user!.DisplayName
                : (state.User.Identity.Name ?? "");
        }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('user-menu-logout-form').submit()");
    }
}
