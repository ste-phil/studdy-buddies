@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<FlipCard IsFlipped="_revealed" OnClick="HandleClick" ExtraClass="@(_wiggling ? "is-wiggling" : null)">
    <FrontContent>
        <MudText Typo="Typo.caption" Color="Color.Tertiary">
            @Card.TermLanguage.ToUpper()
        </MudText>
        <MudText Typo="Typo.h3" Align="Align.Center" Class="my-4">
            @Card.Term
        </MudText>
        <div @onclick:stopPropagation="true">
            <MudIconButton Icon="@Icons.Material.Filled.VolumeUp"
                           OnClick="SpeakTerm"
                           Color="Color.Primary" />
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-4">
            @L["Study.TapToFlip"]
        </MudText>
    </FrontContent>
    <BackContent>
        <MudText Typo="Typo.caption" Color="Color.Tertiary">
            @Card.TranslationLanguage.ToUpper()
        </MudText>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="my-3">
            @Card.Translation
        </MudText>
        @if (!string.IsNullOrWhiteSpace(Card.Example))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                @Card.Example
            </MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(Card.Notes))
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mt-2">
                @Card.Notes
            </MudText>
        }
    </BackContent>
</FlipCard>

<GradeButtons Disabled="@(!_revealed)" Pulsing="@_pulsing" OnGrade="Grade" />

@if (!_revealed)
{
    <MudText Typo="Typo.caption" Align="Align.Center" Class="d-block mt-2" Color="Color.Tertiary">
        @L["Study.FlipToGrade"]
    </MudText>
}

@code {
    [Parameter, EditorRequired] public StudyCard Card { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback<StudyAttemptInput> OnAttempt { get; set; }

    private bool _revealed;
    private string? _pulsing;
    private bool _wiggling;

    private void HandleClick()
    {
        if (!_revealed) _revealed = true;
    }

    private async Task SpeakTerm()
    {
        await JS.InvokeVoidAsync("studyBuddiesSpeech.speak", Card.Term, Card.TermLanguage);
    }

    private async Task Grade(ReviewGrade grade)
    {
        if (!_revealed) return;
        _pulsing = grade.ToString().ToLowerInvariant();

        if (grade >= ReviewGrade.Good)
        {
            try { await JS.InvokeVoidAsync("studyBuddiesConfetti.burst", grade == ReviewGrade.Easy ? 52 : 36); }
            catch { /* JS interop may be unavailable during prerender */ }
        }
        else if (grade == ReviewGrade.Bad)
        {
            _wiggling = true;
        }

        StateHasChanged();
        await Task.Delay(grade == ReviewGrade.Bad ? 520 : 280);
        _wiggling = false;
        await OnAttempt.InvokeAsync(new StudyAttemptInput(
            Card.WordId,
            StudyMode.Flashcard,
            grade,
            grade >= ReviewGrade.Hard,
            null,
            null));
    }
}
