@page "/words/{WordId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

@inject IWordService WordService
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_word?.Term ?? L["Word.AddNew"].Value)</PageTitle>

@if (_word is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" GutterBottom="true">
        @_word.Term <MudText Inline="true" Typo="Typo.caption">@_word.TermLanguage.ToUpper() → @_word.TranslationLanguage.ToUpper()</MudText>
    </MudText>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudTextField @bind-Value="_term" Label="@L["Word.TermLabel"]" Variant="Variant.Outlined" ReadOnly="!_word.IsAuthoredByMe" Class="mb-3" />
        <MudTextField @bind-Value="_translation" Label="@L["Word.TranslationLabel"]" Variant="Variant.Outlined" ReadOnly="!_word.IsAuthoredByMe" Class="mb-3" />
        <MudTextField @bind-Value="_example" Label="@L["Word.ExampleLabel"]" Variant="Variant.Outlined" ReadOnly="!_word.IsAuthoredByMe" Class="mb-3" />
        <MudTextField @bind-Value="_notes" Label="@L["Word.NotesLabel"]" Variant="Variant.Outlined" Lines="2" ReadOnly="!_word.IsAuthoredByMe" Class="mb-3" />
        <TagSelector Selected="_tags"
                     SelectedChanged="OnTagsChanged"
                     Suggestions="_suggestedTags"
                     Label="@L["Word.TagsLabel"]"
                     ReadOnly="!_word.IsAuthoredByMe" />

        @if (_word.IsAuthoredByMe)
        {
            <div class="actions-row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@_saving">
                    @L["Common.Save"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Delete">
                    @L["Common.Delete"]
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info">@L["Word.OnlyAuthorEdit"]</MudAlert>
        }
    </MudPaper>
}

@code {
    [Parameter] public Guid WordId { get; set; }

    private string? _userId;
    private WordSummary? _word;
    private string _term = "";
    private string _translation = "";
    private string _example = "";
    private string _notes = "";
    private List<string> _tags = new();
    private List<string> _suggestedTags = new();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = UserManager.GetUserId(auth.User);
        if (_userId is null) return;

        _word = await WordService.GetWordAsync(WordId, _userId);
        if (_word is not null)
        {
            _term = _word.Term;
            _translation = _word.Translation;
            _example = _word.Example ?? "";
            _notes = _word.Notes ?? "";
            _tags = _word.Tags.ToList();

            try
            {
                _suggestedTags = await WordService.GetExistingTagsAsync(_word.PartnershipId, _userId);
            }
            catch
            {
                _suggestedTags = new List<string>();
            }
        }
    }

    private void OnTagsChanged(List<string> tags)
    {
        _tags = tags;
    }

    private async Task Save()
    {
        if (_userId is null || _word is null) return;
        _saving = true;
        try
        {
            await WordService.UpdateWordAsync(WordId, _userId,
                new WordCreateInput(_term, _translation,
                    string.IsNullOrWhiteSpace(_example) ? null : _example,
                    string.IsNullOrWhiteSpace(_notes) ? null : _notes,
                    _tags));

            Snackbar.Add(L["Word.Saved"].Value, Severity.Success);
            _word = await WordService.GetWordAsync(WordId, _userId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Delete()
    {
        if (_userId is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Word.ConfirmDelete"].Value);
        if (!confirmed) return;

        try
        {
            await WordService.DeleteWordAsync(WordId, _userId);
            Snackbar.Add(L["Word.Deleted"].Value, Severity.Success);
            Nav.NavigateTo("dashboard");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
