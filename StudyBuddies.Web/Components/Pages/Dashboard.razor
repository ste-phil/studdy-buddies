@page "/"
@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

@inject IPartnershipService PartnershipService
@inject IStudyService Study
@inject IStreakService StreakService
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Dashboard.Title"]</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-center pa-12">
        <MudProgressCircular Indeterminate="true" />
    </div>
}
else if (_current is null)
{
    <WelcomeEmptyState />
}
else
{
    <div class="dashboard-hero">
        <h1>@string.Format(L["Dashboard.Hello"].Value, _displayName) <span aria-hidden="true">👋</span></h1>
        <div class="hero-subtitle">
            @if (_stats?.DueCount > 0)
            {
                @string.Format(L["Dashboard.Subtitle.Due"].Value, _stats.DueCount)
            }
            else
            {
                @L["Dashboard.Subtitle.NoDue"]
            }
        </div>

        <MudChip T="string"
                 Color="Color.Default"
                 Variant="Variant.Outlined"
                 OnClick="OpenSwitcher"
                 Class="partner-chip"
                 Size="Size.Medium">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <span class="fi fi-@_current.Partner.NativeLanguage.ToLower() partner-flag"></span>
                <span>@_current.Partner.DisplayName</span>
                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" />
                <span class="fi fi-@_userLanguage.ToLower() partner-flag"></span>
                <span>@_displayName</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
            </MudStack>
        </MudChip>
    </div>

    <SweetMessage PartnerName="@_current.Partner.DisplayName" />

    <CoupleHub Partnership="_current" MyDisplayName="@_displayName" MyLanguage="@_userLanguage" />

    <MudGrid Spacing="3" Class="mt-2">
        <MudItem xs="12" sm="4">
            <div class="action-card action-card-study"
                 @onclick="@(() => GoTo($"partners/{_current.Id}/study"))">
                <div class="icon-circle icon-circle-lg icon-circle-primary">
                    <MudIcon Icon="@Icons.Material.Filled.School" Style="font-size:1.75rem" />
                </div>
                <div class="action-card-body">
                    <div class="action-card-title">@L["Dashboard.Action.Study"]</div>
                    <div class="action-card-subtitle">
                        @if (_stats?.DueCount > 0)
                        {
                            @string.Format(L["Dashboard.Action.Study.Subtitle.Some"].Value, _stats.DueCount)
                        }
                        else
                        {
                            @L["Dashboard.Action.Study.Subtitle.None"]
                        }
                    </div>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="4">
            <div class="action-card action-card-add"
                 @onclick="@(() => GoTo($"partners/{_current.Id}/words/new"))">
                <div class="icon-circle icon-circle-lg icon-circle-secondary">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:1.75rem" />
                </div>
                <div class="action-card-body">
                    <div class="action-card-title">@L["Dashboard.Action.AddWord"]</div>
                    <div class="action-card-subtitle">@L["Dashboard.Action.AddWord.Subtitle"]</div>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="4">
            <div class="action-card action-card-words"
                 @onclick="@(() => GoTo("words"))">
                <div class="icon-circle icon-circle-lg icon-circle-tertiary">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Style="font-size:1.75rem" />
                </div>
                <div class="action-card-body">
                    <div class="action-card-title">@L["Dashboard.Action.MyWords"]</div>
                    <div class="action-card-subtitle">@L["Dashboard.Action.MyWords.Subtitle"]</div>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    @if (_stats is not null)
    {
        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="6" sm="3">
                <StatTile Variant="streak"
                          Icon="@Icons.Material.Filled.LocalFireDepartment"
                          Label="@(L["Dashboard.Stat.Streak"].Value)"
                          Value="@(_stats.Streak.ToString())"
                          SubLabel="@(_stats.Streak > 0 ? L["Dashboard.Stat.Streak.Sub"].Value : L["Dashboard.Stat.Streak.Zero"].Value)"
                          Glow="@(_stats.Streak >= 3)" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <StatTile Variant="learned"
                          Icon="@Icons.Material.Filled.Star"
                          Label="@(L["Dashboard.Stat.Learned"].Value)"
                          Value="@(_stats.LearnedCount.ToString())"
                          SubLabel="@(L["Dashboard.Stat.Learned.Sub"].Value)" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <StatTile Variant="due"
                          Icon="@Icons.Material.Filled.MenuBook"
                          Label="@(L["Dashboard.Stat.Due"].Value)"
                          Value="@(_stats.DueCount.ToString())"
                          SubLabel="@(L["Dashboard.Stat.Due.Sub"].Value)" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <StatTile Variant="progress"
                          Icon="@Icons.Material.Filled.TrendingUp"
                          Label="@(L["Dashboard.Stat.Progress"].Value)"
                          Value="@($"{ProgressPercent:0}%")"
                          SubLabel="@(L["Dashboard.Stat.Progress.Sub"].Value)" />
            </MudItem>
        </MudGrid>

        <div class="progress-card mt-4 @(GoalReached ? "is-goal-reached" : "")">
            <div class="progress-card-header">
                <div class="progress-card-title">@L["Dashboard.Progress.Title"]</div>
                <div class="progress-card-counter">
                    @string.Format(L["Dashboard.Progress.Done"].Value, _stats.TodayCount, _stats.DailyGoal)
                    <span class="ml-1" aria-hidden="true">🏆</span>
                </div>
            </div>
            <MudProgressLinear Value="@ProgressPercent"
                               Color="Color.Tertiary"
                               Rounded="true"
                               Size="Size.Large" />
            @if (GoalReached)
            {
                <div class="progress-card-celebrate">
                    <span aria-hidden="true">🎉</span>
                    <span>@L["Dashboard.Progress.ReachedCelebration"]</span>
                </div>
            }
            else
            {
                <div class="progress-card-sub">
                    @string.Format(L["Dashboard.Progress.Remaining"].Value, _stats.DailyGoal - _stats.TodayCount)
                </div>
            }
        </div>

        @if (_accuracy is { Total: > 0 })
        {
            <div class="progress-card mt-3">
                <div class="progress-card-header">
                    <div class="progress-card-title">@L["Dashboard.Accuracy.Title"]</div>
                    <div class="progress-card-counter">
                        @string.Format(L["Dashboard.Accuracy.Body"].Value,
                            _accuracy.Correct,
                            _accuracy.Total,
                            (int)Math.Round(_accuracy.Correct * 100.0 / _accuracy.Total))
                    </div>
                </div>
                <MudProgressLinear Value="@(_accuracy.Correct * 100.0 / _accuracy.Total)"
                                   Color="Color.Success"
                                   Rounded="true"
                                   Size="Size.Large" />
            </div>
        }
    }
}

@code {
    private bool _loading = true;
    private string? _userId;
    private string _displayName = "";
    private string _userLanguage = "";
    private PartnershipSummary? _current;
    private DashboardStats? _stats;
    private TodayAccuracy? _accuracy;

    private double ProgressPercent =>
        _stats is null || _stats.DailyGoal <= 0
            ? 0
            : Math.Min(100, Math.Round(_stats.TodayCount * 100.0 / _stats.DailyGoal));

    private bool GoalReached =>
        _stats is not null && _stats.DailyGoal > 0 && _stats.TodayCount >= _stats.DailyGoal;

    private bool _celebratedOnce;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !GoalReached || _celebratedOnce) return;
        _celebratedOnce = true;
        try { await JS.InvokeVoidAsync("studyBuddiesConfetti.burst", 48); }
        catch { /* ignore prerender / JS unavailable */ }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = UserManager.GetUserId(auth.User);
        if (_userId is null)
        {
            Nav.NavigateTo("Account/Login");
            return;
        }
        await Load();
    }

    private async Task Load()
    {
        if (_userId is null) return;
        var user = await UserManager.FindByIdAsync(_userId);
        if (user is not null)
        {
            _displayName = user.DisplayName;
            _userLanguage = user.NativeLanguage;
        }

        _current = await PartnershipService.GetCurrentPartnershipAsync(_userId);
        if (_current is not null)
        {
            var statsTask = Study.GetStatsAsync(_current.Id, _userId);
            var streakTask = StreakService.GetCurrentStreakAsync(_userId);
            var todayTask = Study.GetTodayReviewCountAsync(_userId);
            var accuracyTask = Study.GetTodayAccuracyAsync(_userId);
            await Task.WhenAll(statsTask, streakTask, todayTask, accuracyTask);
            _stats = new DashboardStats(
                statsTask.Result.DueCount,
                statsTask.Result.NewCount,
                statsTask.Result.LearnedCount,
                streakTask.Result,
                todayTask.Result,
                StudyBuddies.Core.Services.StudyService.DailyGoal);
            _accuracy = accuracyTask.Result;
        }
        _loading = false;
    }

    private async Task OpenSwitcher()
    {
        if (_current is null) return;
        var parameters = new DialogParameters { ["CurrentPartnershipId"] = _current.Id };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<PartnerSwitcher>(L["PartnerSwitcher.Title"].Value, parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is Guid)
        {
            await Load();
            StateHasChanged();
        }
    }

    private void GoTo(string url) => Nav.NavigateTo(url);
}
