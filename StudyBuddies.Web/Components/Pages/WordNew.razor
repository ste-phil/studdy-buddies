@page "/partners/{PartnershipId:guid}/words/new"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

@inject IPartnershipService PartnershipService
@inject IWordService WordService
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Word.AddNew"]</PageTitle>

@if (_partnership is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h5">@string.Format(L["Word.New"].Value, _partnership.Partner.DisplayName)</MudText>
    </MudStack>
    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-4">
        @string.Format(L["Word.NewSubtext"].Value, _myLanguage.ToUpper(), _partnership.Partner.NativeLanguage.ToUpper())
    </MudText>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudTextField @bind-Value="_term" Label="@($"{L["Word.TermLabel"]} ({_myLanguage.ToUpper()})")" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_translation" Label="@($"{L["Word.TranslationLabel"]} ({_partnership.Partner.NativeLanguage.ToUpper()})")" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_example" Label="@L["Word.ExampleLabel"]" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_notes" Label="@L["Word.NotesLabel"]" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
        <TagSelector Selected="_tags"
                     SelectedChanged="OnTagsChanged"
                     Suggestions="_suggestedTags"
                     Label="@L["Word.TagsLabel"]" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@_saving">
            @L["Common.Save"]
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public Guid PartnershipId { get; set; }

    private string? _userId;
    private string _myLanguage = "";
    private PartnershipSummary? _partnership;

    private string _term = "";
    private string _translation = "";
    private string _example = "";
    private string _notes = "";
    private List<string> _tags = new();
    private List<string> _suggestedTags = new();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = UserManager.GetUserId(auth.User);
        if (_userId is null) return;

        _partnership = await PartnershipService.GetPartnershipAsync(PartnershipId, _userId);
        var me = await UserManager.GetUserAsync(auth.User);
        _myLanguage = me?.NativeLanguage ?? "";

        try
        {
            _suggestedTags = await WordService.GetExistingTagsAsync(PartnershipId, _userId);
        }
        catch
        {
            _suggestedTags = new List<string>();
        }
    }

    private void OnTagsChanged(List<string> tags)
    {
        _tags = tags;
    }

    private async Task Save()
    {
        if (_userId is null) return;
        _saving = true;
        try
        {
            await WordService.CreateWordAsync(PartnershipId, _userId,
                new WordCreateInput(_term, _translation,
                    string.IsNullOrWhiteSpace(_example) ? null : _example,
                    string.IsNullOrWhiteSpace(_notes) ? null : _notes,
                    _tags));

            Snackbar.Add(L["Word.Saved"].Value, Severity.Success);
            await JS.InvokeVoidAsync("history.back");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
