@page "/partners/{PartnershipId:guid}/study"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

@inject IStudyService StudyService
@inject IWordService WordService
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Study.Title"]</PageTitle>

<div class="study-page">
    <div class="study-container">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
            <MudText Typo="Typo.h5">@L["Study.Title"]</MudText>
            <MudSpacer />
            @if (!_loading && _total > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Tertiary">
                    @_done / @_total (@($"{(int)Math.Round(_total == 0 ? 0 : (_done * 100.0 / _total))}%"))
                </MudText>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Tune"
                           Size="Size.Small"
                           Color="@(_showFilter ? Color.Primary : Color.Default)"
                           OnClick="ToggleFilter"
                           aria-label="@L["Study.ModeFilter.Title"]" />
        </MudStack>

        @if (_showFilter)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Study.ModeFilter.Title"]</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    @foreach (var mode in _allModes)
                    {
                        var selected = _allowedModes.Contains(mode);
                        <MudChip T="StudyMode"
                                 Value="@mode"
                                 Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                 Color="@(selected ? Color.Primary : Color.Default)"
                                 OnClick="@(() => ToggleMode(mode))">
                            @L[$"Study.Mode.{mode}"]
                        </MudChip>
                    }
                </MudStack>
                @if (_allowedModes.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-2 d-block">
                        @L["Study.ModeFilter.NoneSelected"]
                    </MudText>
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Study.TagFilter.Title"]</MudText>
                @if (_availableTags.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="d-block">
                        @L["Study.TagFilter.NoTags"]
                    </MudText>
                }
                else
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                        @foreach (var tag in _availableTags)
                        {
                            var tagSelected = _selectedTags.Contains(tag);
                            <MudChip T="string"
                                     Value="@tag"
                                     Variant="@(tagSelected ? Variant.Filled : Variant.Outlined)"
                                     Color="@(tagSelected ? Color.Secondary : Color.Default)"
                                     OnClick="@(() => ToggleTag(tag))">
                                @tag
                            </MudChip>
                        }
                    </MudStack>
                    @if (_selectedTags.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2 d-block">
                            @L["Study.TagFilter.AllTags"]
                        </MudText>
                    }
                }
            </MudPaper>
        }

        @if (!_loading && _total > 0)
        {
            <MudProgressLinear Color="Color.Primary"
                               Value="@(_total == 0 ? 0 : (_done * 100.0 / _total))"
                               Rounded="true"
                               Size="Size.Medium"
                               Class="mb-6" />
        }

        @if (_loading)
        {
            <div class="d-flex justify-center pa-12">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else if (_allowedModes.Count == 0)
        {
            <MudPaper Class="pa-8 text-center" Elevation="0" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4">@L["Study.ModeFilter.NoneSelected"]</MudText>
            </MudPaper>
        }
        else if (_currentCard is null)
        {
            <MudPaper Class="pa-8 text-center" Elevation="0" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-4">@L["Study.NoCards"]</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack" Class="mt-4">
                    @L["Study.GoBack"]
                </MudButton>
            </MudPaper>
        }
        else
        {
            <StudyModeHost @key="_currentCard.WordId" Card="_currentCard" OnAttempt="HandleAttempt" />
        }
    </div>
</div>

@code {
    [Parameter] public Guid PartnershipId { get; set; }

    private static readonly StudyMode[] _allModes =
    {
        StudyMode.Flashcard,
        StudyMode.Type,
        StudyMode.MultipleChoice,
        StudyMode.Listening,
        StudyMode.Cloze,
    };

    private bool _loading = true;
    private bool _showFilter;
    private bool _prefsLoaded;
    private string? _userId;
    private Queue<StudyCard> _queue = new();
    private StudyCard? _currentCard;
    private int _total;
    private int _done;
    private HashSet<StudyMode> _allowedModes = new(_allModes);
    private List<string> _availableTags = new();
    private HashSet<string> _selectedTags = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = UserManager.GetUserId(auth.User);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _prefsLoaded || _userId is null) return;
        _prefsLoaded = true;

        try
        {
            var saved = await JS.InvokeAsync<string[]?>("studyBuddiesPrefs.getStudyModes");
            if (saved is { Length: > 0 })
            {
                var parsed = new HashSet<StudyMode>();
                foreach (var name in saved)
                {
                    if (Enum.TryParse<StudyMode>(name, out var m)) parsed.Add(m);
                }
                if (parsed.Count > 0) _allowedModes = parsed;
            }
        }
        catch
        {
        }

        try
        {
            _availableTags = await WordService.GetExistingTagsAsync(PartnershipId, _userId);
        }
        catch
        {
            _availableTags = new List<string>();
        }

        try
        {
            var savedTags = await JS.InvokeAsync<string[]?>("studyBuddiesPrefs.getStudyTags", PartnershipId);
            if (savedTags is { Length: > 0 })
            {
                var tagSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                foreach (var t in savedTags)
                {
                    if (_availableTags.Contains(t, StringComparer.OrdinalIgnoreCase))
                    {
                        tagSet.Add(t);
                    }
                }
                _selectedTags = tagSet;
            }
        }
        catch
        {
        }

        await ReloadCardsAsync();
    }

    private async Task ReloadCardsAsync()
    {
        if (_userId is null) return;
        _loading = true;
        StateHasChanged();

        if (_allowedModes.Count == 0)
        {
            _queue.Clear();
            _currentCard = null;
            _total = 0;
            _done = 0;
            _loading = false;
            StateHasChanged();
            return;
        }

        IReadOnlySet<string>? tagFilter = _selectedTags.Count > 0 ? _selectedTags : null;
        var cards = await StudyService.GetDueCardsAsync(PartnershipId, _userId, allowedModes: _allowedModes, tagFilter: tagFilter);
        if (cards.Count == 0)
        {
            cards = await StudyService.GetExtraPracticeCardsAsync(PartnershipId, _userId, allowedModes: _allowedModes, tagFilter: tagFilter);
        }
        _queue = new Queue<StudyCard>(cards);
        _total = _queue.Count;
        _done = 0;
        LoadNext();
        _loading = false;
        StateHasChanged();
    }

    private void LoadNext()
    {
        _currentCard = _queue.Count > 0 ? _queue.Dequeue() : null;
    }

    private async Task HandleAttempt(StudyAttemptInput input)
    {
        if (_userId is null) return;
        try
        {
            await StudyService.GradeAsync(input, _userId);
            _done++;
            LoadNext();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ToggleFilter() => _showFilter = !_showFilter;

    private async Task ToggleMode(StudyMode mode)
    {
        if (!_allowedModes.Add(mode))
        {
            _allowedModes.Remove(mode);
        }

        try
        {
            await JS.InvokeVoidAsync(
                "studyBuddiesPrefs.setStudyModes",
                (object)_allowedModes.Select(m => m.ToString()).ToArray());
        }
        catch
        {
        }

        await ReloadCardsAsync();
    }

    private async Task ToggleTag(string tag)
    {
        if (!_selectedTags.Add(tag))
        {
            _selectedTags.Remove(tag);
        }

        try
        {
            await JS.InvokeVoidAsync(
                "studyBuddiesPrefs.setStudyTags",
                PartnershipId,
                (object)_selectedTags.ToArray());
        }
        catch
        {
        }

        await ReloadCardsAsync();
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
